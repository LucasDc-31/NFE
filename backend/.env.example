# --- Servidor ---
PORT=3000

# --- Login do app ---
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar a sessão (use algo longo e aleatório, ex.: saída de `openssl rand -hex 32`)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Opcional: restringe quais sites podem chamar a API (separe por vírgula). Vazio = qualquer.
# Não precisa quando o PWA é servido pelo próprio backend.
CORS_ORIGIN=

# --- Focus NFe ---
# Homologação (testes): https://homologacao.focusnfe.com.br
# Produção:             https://api.focusnfe.com.br
FOCUS_BASE_URL=https://homologacao.focusnfe.com.br
FOCUS_TOKEN=seu-token-focus-nfe

# --- Emitente (sua empresa) ---
# Na Focus, a empresa precisa estar cadastrada com certificado digital e com o CSC (id + token)
# da NFC-e do seu estado. Isso é feito no painel da Focus, não aqui.
EMITENTE_CNPJ=00000000000000

# --- Tributação padrão (confirme com seu contador) ---
# Origem da mercadoria: 0 = nacional
ICMS_ORIGEM=0
# CST de PIS/COFINS usado para empresas do Simples Nacional (ex.: 07 ou 49)
PIS_COFINS_CST=07
# NCM, CFOP e CSOSN de cada categoria ficam em backend/data/produtos.json

# --- E-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app
MAIL_FROM="Minha Empresa <seu-email@gmail.com>"
